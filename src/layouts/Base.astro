---
import '../styles/global.css';
import NavRail from '../components/NavRail.astro';

interface Props {
  title?: string;
  description?: string;
}

const SITE_NAME = "Achi_kyw's website";

const { title, description = "Achi_kyw's personal website — experience, projects, and blog." } =
  Astro.props;

// 頁面只傳區塊名(如 "About"),後綴統一在這裡加
const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-icon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f3edf7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#211f26" />
    <!-- 進頁面前先套用主題,避免暗色使用者看到白色閃一下 -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('theme');
        var dark = saved
          ? saved === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body>
    <NavRail />
    <div class="page">
      <main class="container">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="container">
          <p>
            © {new Date().getFullYear()} Achi_kyw ·
            <a href="/blog/">Blog</a> ·
            <a href="https://github.com/Achi-kyw" target="_blank" rel="noopener">GitHub</a>
            <span class="footer-sep">|</span>
            <span class="footer-credits">
              Content licensed under
              <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="noopener license">CC BY-NC 4.0</a>
              · UI based on
              <a href="https://m3.material.io/" target="_blank" rel="noopener">Material Design 3</a>
              (©&nbsp;Google, <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>)
              · Icons:
              <a href="https://fonts.google.com/icons" target="_blank" rel="noopener">Material Symbols</a>
              (Apache 2.0)
            </span>
          </p>
        </div>
      </footer>
    </div>
    <script>
      // M3 ripple:從點擊點向外擴散的 pressed state layer
      const HOSTS =
        '.btn, .menu-btn, .project-card, .contact-card, .drawer-item, .rail-logo, .bar-logo, .nav-item, .timeline > li, .chips span';

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      document.addEventListener('pointerdown', (e) => {
        // 減少動態效果模式:CSS 會隱藏 ripple,動畫不會跑,不要製造節點
        if (reducedMotion.matches) return;
        const target = e.target as Element | null;
        const hit = target?.closest?.(HOSTS);
        if (!hit) return;
        // nav 項目的漣漪長在膠囊指示器裡;時間軸條目的漣漪長在右側內容區
        const host = hit.classList.contains('nav-item')
          ? hit.querySelector('.icon-pill')
          : hit.matches('.timeline li')
            ? hit.querySelector('.entry-body')
            : hit;
        if (!host) return;

        const rect = host.getBoundingClientRect();
        const inside =
          e.clientX >= rect.left &&
          e.clientX <= rect.right &&
          e.clientY >= rect.top &&
          e.clientY <= rect.bottom;
        const x = inside ? e.clientX - rect.left : rect.width / 2;
        const y = inside ? e.clientY - rect.top : rect.height / 2;
        // 半徑取到最遠角落,漣漪才蓋得滿整個元件
        const r = Math.hypot(Math.max(x, rect.width - x), Math.max(y, rect.height - y));

        const span = document.createElement('span');
        span.className = 'ripple';
        span.style.left = `${x - r}px`;
        span.style.top = `${y - r}px`;
        span.style.width = span.style.height = `${r * 2}px`;
        host.appendChild(span);
        span.addEventListener('animationend', (ev) => {
          if (ev.animationName === 'ripple-fade') span.remove();
        });
      });
    </script>
  </body>
</html>
